# Forgeflow Distributed Worker Node Configuration
# Deploy this file to any remote server / VM and configure.

# Central Forgeflow Control Plane URL
CONTROL_PLANE_URL=http://localhost:8080

# Unique ID and metadata for this worker node
WORKER_ID=worker-srv-us-east-1
WORKER_HOSTNAME=srv-us-east-1.forgeflow.local
WORKER_IP=192.168.1.100

# Comma-separated list of skills this server executes
# E.g.: bug-fix,dependency-remediation,test-repair, or * for all
WORKER_SKILLS=bug-fix,dependency-remediation,test-repair

# Polling interval in milliseconds
POLL_INTERVAL_MS=3000
HEARTBEAT_INTERVAL_MS=10000

# LLM Provider Configuration (100% Free options supported)
# Options:
# 1. Groq (Free tier - ultra fast Llama 3):
#    LLM_API_BASE=https://api.groq.com/openai/v1
#    LLM_API_KEY=gsk_...
#    LLM_MODEL=llama-3.3-70b-versatile
#
# 2. Ollama (Fully local, no API key):
#    LLM_API_BASE=http://localhost:11434/v1
#    LLM_API_KEY=ollama
#    LLM_MODEL=llama3:8b
#
# 3. Google Gemini (OpenAI compatible endpoint / LiteLLM):
#    LLM_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai/
#    LLM_API_KEY=AIzaSy...
#    LLM_MODEL=gemini-1.5-flash
LLM_API_BASE=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile

# Strict token budget limits per run to prevent runaway costs
MAX_INPUT_TOKENS_PER_STEP=6000
MAX_OUTPUT_TOKENS_PER_STEP=800
MAX_TOTAL_TOKENS_PER_RUN=30000
MAX_AGENT_ITERATIONS=6
