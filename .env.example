# ── Forgeflow environment variables template ─────────────────────────────────
# Copy this file to .env and fill in your real credentials.
# NEVER commit your real .env file or private keys to version control!

# MongoDB connection string
# Local dev:        mongodb://localhost:27017/forgeflow
# MongoDB Atlas:    mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/forgeflow
MONGODB_URI=mongodb://localhost:27017/forgeflow

# JWT signing secret — generate with: openssl rand -hex 32
JWT_SECRET=replace-me-with-at-least-32-random-characters

# GitHub App credentials
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=

# LLM provider configuration (Gemini / Groq / OpenAI)
LLM_PROVIDER=gemini
LLM_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=
LLM_MODEL=gemini-flash-lite-latest

# Code RAG Embeddings (Voyage AI)
VOYAGE_API_URL=https://ai.mongodb.com/v1/embeddings
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-code-3

# PR Analysis & GitHub Integration
GH_TOKEN=
GEMINI_API_KEY=
CHAT_AI_API_KEY=
